@model AcademicCalendarLeave.Models.AcademicViewModel
@{
    ViewData["Title"] = "Overview";
    var isDark = Context.Request.Cookies["campus-theme"] == "dark";
}

<section class="hero" id="overview">
    <div><p class="eyebrow">MONDAY, 07 SEPTEMBER 2026</p><h1>Good morning, @Model.DisplayName.Split(' ')[0].</h1><p class="hero-copy">Your academic rhythm, in one calm place.</p></div>
    <div class="hero-actions"><span class="avatar">MP</span><div><strong>Student account</strong><small>Computer Science · Year 3</small></div><form asp-action="SetTheme" method="post"><input type="hidden" name="theme" value="@(isDark ? "light" : "dark")" /><button class="icon-button" title="Switch to @(isDark ? "light" : "dark") theme" aria-label="Switch theme">@(isDark ? "☼" : "◐")</button></form></div>
</section>
@if (Model.Notice is not null){<div class="notice" role="status">@Model.Notice <a href="#requests">View requests</a></div>}
<section class="metric-grid" aria-label="Academic summary">
    <article class="metric-card accent-coral"><span>Attendance</span><strong>92.4%</strong><small>↑ 2.8% this term</small></article>
    <article class="metric-card accent-yellow"><span>Leave balance</span><strong>08 <em>days</em></strong><small>of 12 days remaining</small></article>
    <article class="metric-card accent-teal"><span>Next deadline</span><strong>14 <em>Sep</em></strong><small>Mid-semester assessments</small></article>
    <article class="metric-card accent-blue"><span>Credits earned</span><strong>68%</strong><small>34 of 50 credits</small></article>
</section>
<div class="workspace-grid">
    <section class="panel calendar-panel" id="calendar"><div class="panel-heading"><div><p class="eyebrow">YOUR SCHEDULE</p><h2>Academic calendar</h2></div><button class="outline-button">＋ Add event</button></div>
        <form asp-action="Index" method="get" class="calendar-toolbar"><select asp-for="SelectedMonth" class="control-select" aria-label="Calendar month"><option>September 2026</option><option>October 2026</option><option>November 2026</option></select><select asp-for="SelectedFilter" class="control-select" aria-label="Calendar event type"><option>All events</option><option>Assessments</option><option>Deadlines</option><option>Campus events</option></select><button class="view-button active" type="submit">Apply</button></form>
        <div class="event-list">@if (Model.Events.Count == 0){<p class="empty-state">No events match this month and filter.</p>} @foreach (var calendarEvent in Model.Events){<div class="event-row"><div class="date-block"><strong>@calendarEvent.Day</strong><span>@calendarEvent.Month</span></div><div class="event-marker @calendarEvent.Type"></div><div class="event-content"><strong>@calendarEvent.Title</strong><span>@calendarEvent.Meta</span></div><button class="more-button" aria-label="More options">•••</button></div>}</div>
    </section>
    <section class="panel leave-panel" id="leave"><div class="panel-heading"><div><p class="eyebrow">TIME AWAY</p><h2>Request leave</h2></div><span class="mini-badge">08 days left</span></div>
        <form asp-action="ApplyLeave" method="post" class="leave-form">@Html.AntiForgeryToken()<input asp-for="SelectedMonth" type="hidden" /><input asp-for="SelectedFilter" type="hidden" /><label>Leave type<select asp-for="LeaveType" class="form-control"><option>Casual leave</option><option>Medical leave</option><option>Emergency leave</option><option>Academic leave</option></select></label><div class="date-fields"><label>From<input asp-for="StartDate" class="form-control" type="date" /></label><label>To<input asp-for="EndDate" class="form-control" type="date" /></label></div><label>Reason<textarea asp-for="Reason" class="form-control" rows="3" placeholder="Give a short reason for your request..."></textarea></label><label class="check-row"><input asp-for="NotifyFaculty" type="checkbox" /> <span>Notify my faculty coordinator</span></label><button class="primary-button" type="submit">Submit leave request <span>→</span></button></form>
    </section>
</div>
<section class="panel requests-panel" id="requests"><div class="panel-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>Leave requests</h2></div><a class="text-link" href="#leave">View all requests →</a></div><div class="request-table"><div class="table-head"><span>TYPE</span><span>DATES</span><span>REASON</span><span>STATUS</span></div>@foreach (var request in Model.LeaveRequests){<div class="table-row"><strong>@request.Type</strong><span>@request.StartDate.ToString("dd MMM") – @request.EndDate.ToString("dd MMM yyyy")</span><span>@request.Reason</span><span class="pill @request.Status.ToLowerInvariant()">@request.Status</span></div>}</div></section>
